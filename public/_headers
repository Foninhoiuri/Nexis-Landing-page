# Cloudflare Pages — HTTP Headers
# Documentação: https://developers.cloudflare.com/pages/configuration/headers/

# ─── ASSETS IMUTÁVEIS (Next.js chunks com hash) ─────────────────────────────
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
  X-Content-Type-Options: nosniff

# ─── IMAGENS E FONTES ESTÁTICAS ─────────────────────────────────────────────
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.jpeg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.svg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

/*.ico
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.mp4
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/*.woff
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# ─── SERVICE WORKER — NUNCA CACHEAR ─────────────────────────────────────────
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# ─── MANIFEST ────────────────────────────────────────────────────────────────
/manifest.json
  Cache-Control: public, max-age=86400, must-revalidate
  Content-Type: application/manifest+json

# ─── PÁGINA OFFLINE ──────────────────────────────────────────────────────────
/offline.html
  Cache-Control: public, max-age=86400

# ─── HTML (páginas principais) — Sempre fresco ──────────────────────────────
/
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/*.html
  Cache-Control: public, max-age=3600, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN

# ─── HEADERS DE SEGURANÇA GLOBAIS ────────────────────────────────────────────
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
